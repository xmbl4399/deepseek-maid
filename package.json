{
  "name": "deepseek-desktop",
  "version": "1.2.2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/smoke-test.js && node scripts/require-check.js",
    "lint": "eslint main.js ui/*.js modules/*.js scripts/*.js",
    "build": "electron-builder --publish never"
  },
  "keywords": [],
  "author": "xmbl4399",
  "license": "MIT",
  "description": "DeepSeek 网页版桌面客户端(多标签 + 悬浮球/鲸鱼娘桌宠 + 框选截图提问)",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xmbl4399/deepseek-maid"
  },
  "publish": {
    "provider": "github",
    "owner": "xmbl4399",
    "repo": "deepseek-maid",
    "releaseType": "release"
  },
  "build": {
    "appId": "com.deepseek.desktop",
    "productName": "DeepSeek Desktop",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "modules/**/*",
      "ui/**/*",
      "!ui/**/*.bak",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "shortcutName": "DeepSeek",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "DeepSeek-Desktop-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.8"
  }
}
