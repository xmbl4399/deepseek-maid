{
  "name": "deepseek-desktop",
  "version": "1.2.2",
  "main": "main.js",
  "desktopName": "deepseek-desktop.desktop",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/smoke-test.js && node scripts/require-check.js",
    "lint": "eslint main.js ui/*.js modules/*.js scripts/*.js",
    "build": "electron-builder --publish never"
  },
  "keywords": [],
  "author": "xmbl4399",
  "license": "MIT",
  "description": "DeepSeek 网页版桌面客户端(多标签 + 悬浮球/鲸鱼娘桌宠 + 框选截图提问)",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xmbl4399/deepseek-maid"
  },
  "publish": {
    "provider": "github",
    "owner": "xmbl4399",
    "repo": "deepseek-maid",
    "releaseType": "release"
  },
  "build": {
    "appId": "com.deepseek.desktop",
    "productName": "DeepSeek Desktop",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "modules/**/*",
      "ui/**/*",
      "!ui/**/*.bak",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "shortcutName": "DeepSeek",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "DeepSeek-Desktop-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "ui/logo.png"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icons",
      "executableName": "deepseek-desktop",
      "syncDesktopName": true,
      "category": "Network",
      "synopsis": "DeepSeek 网页版桌面客户端",
      "description": "DeepSeek 网页版桌面客户端(多标签 + 悬浮球/鲸鱼娘桌宠 + 框选截图提问)",
      "maintainer": "xmbl4399 <m18735714399@gmail.com>",
      "vendor": "xmbl4399",
      "desktop": {
        "entry": {
          "Name": "DeepSeek",
          "GenericName": "AI 助手",
          "Categories": "Network;Utility;",
          "Keywords": "deepseek;chat;ai;assistant;"
        }
      },
      "artifactName": "DeepSeek-Desktop-${version}-${arch}.${ext}"
    },
    "deb": {
      "packageName": "deepseek-desktop",
      "priority": "optional",
      "packageCategory": "net",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "x11-utils"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.8"
  }
}
